# Server Configuration
PORT=3000
NODE_ENV=development
AUTO_MIGRATE=true

# Database (PostgreSQL 15)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/lezzflow
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgrespassword
PGDATABASE=lezzflow
DB_SSL=false

# Firebase Admin Authentication
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# AWS Bedrock AI Scanner
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
BEDROCK_MODEL_ID=moonshotai.kimi-k3
# BEDROCK_TIMEOUT_MS: optional — abort AI scan calls that exceed this duration. Default: 25000 (25s).
# BEDROCK_TIMEOUT_MS=25000

# File Storage Configuration
# STORAGE_PROVIDER: 'local' (default, files served from UPLOAD_DIR) or 's3' (real S3 uploads).
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
# AWS_S3_BUCKET: REQUIRED when STORAGE_PROVIDER=s3. Name of a PRIVATE S3 bucket.
#   The app fails to start without it — files are never silently dropped.
# AWS_REGION is reused from the AWS Bedrock section above (S3 default: ap-south-1).
# AWS_S3_BUCKET=lezzflow-uploads
